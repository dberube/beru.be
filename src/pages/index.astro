---
import BaseLayout from '../layouts/BaseLayout.astro';
import IndexedRow from '../components/IndexedRow.astro';
import { getLiveCollection, byFreshnessDesc, number, hasBody } from '../lib/content';
import { site } from '../site';

const [builds, agents, writing, now] = await Promise.all([
  getLiveCollection('builds'),
  getLiveCollection('agents'),
  getLiveCollection('writing'),
  getLiveCollection('now')
]);

const items = [
  ...builds.map((e) => ({
    entry: e,
    category: 'builds',
    type: 'BUILD',
    title: e.data.name,
    summary: e.data.summary,
    href: hasBody(e) ? `/builds/${e.id}/` : e.data.url ?? `/builds/${e.id}/`
  })),
  ...agents.map((e) => ({
    entry: e,
    category: 'agents',
    type: 'AGENT',
    title: e.data.name,
    summary: e.data.summary,
    href: hasBody(e) ? `/agents/${e.id}/` : e.data.url ?? `/agents/${e.id}/`
  })),
  ...writing.map((e) => ({
    entry: e,
    category: 'writing',
    type: 'ESSAY',
    title: e.data.title,
    summary: e.data.summary,
    href: `/writing/${e.id}/`
  })),
  ...now.map((e) => {
    const title = `Now: ${e.data.updated.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}`;
    const href = e.id === 'current' ? '/now/' : `/now/${e.id.replace('archive/', '')}/`;
    return {
      entry: e,
      category: 'writing',
      type: 'NOW',
      title,
      summary: 'A monthly journal of what I’m focused on.',
      href
    };
  })
].sort((a, b) => byFreshnessDesc(a.entry, b.entry));
---
<BaseLayout title="Homepage" path="/" image="/og/site.png">
  <section class="home">

    <h1>Enterprise product leader. Builder at startup speed.</h1>
    
    <p class="serif-lede">By day I lead product for Merck Group (MilliporeSigma), one of the largest global B2B catalogs in life sciences.</p>

    <p class="serif-lede">At UNFI, the world's largest grocery distributor, I led digital and ecommerce, a $10 billion annual sales business; created and led innovation and UNFI Labs; and identified the opportunity for and stood up UNFI Media Network, a new $100 million retail media business inside a $32 billion enterprise.</p>

    <p class="serif-lede">Earlier in my career, I founded, raised, and sold companies. Nights and weekends I ship my own projects: apps, sites, tools, AI experiments, and a team of agents that build with me.</p>

    <div class="feed-filter" aria-label="Filter the latest items">
      <span class="kicker">Latest</span>
      <div class="feed-filter-options" role="group" aria-label="Content type">
        <button type="button" data-filter="all" aria-pressed="true">all</button>
        <button type="button" data-filter="builds" aria-pressed="false">builds</button>
        <button type="button" data-filter="agents" aria-pressed="false">agents</button>
        <button type="button" data-filter="writing" aria-pressed="false">writing</button>
      </div>
    </div>

    <div class="section" data-latest-items>
      {items.map((item, i) => (
        <div data-latest-item data-category={item.category} hidden={i >= 5}>
          <IndexedRow
            number={number(i)}
            meta={item.type}
            title={item.title}
            summary={item.summary}
            href={item.href}
            arrow
          />
        </div>
      ))}
    </div>

    <script>
      const filters = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const latestItems = document.querySelectorAll<HTMLElement>('[data-latest-item]');

      filters.forEach((filter) => {
        filter.addEventListener('click', () => {
          const category = filter.dataset.filter;
          let visible = 0;

          latestItems.forEach((item) => {
            const matches = category === 'all' || item.dataset.category === category;
            item.hidden = !matches || visible >= 5;
            if (matches) {
              if (visible < 5) {
                const itemNumber = item.querySelector<HTMLElement>('.gutter strong');
                if (itemNumber) itemNumber.textContent = String(visible + 1).padStart(3, '0');
              }
              visible += 1;
            }
          });

          filters.forEach((button) => {
            button.setAttribute('aria-pressed', String(button === filter));
          });
        });
      });
    </script>

    <div class="cta">
      <div class="cta-left">
        <a class="button" href={`mailto:${site.email}`}>Email David</a>
        <a href={site.linkedin}>LinkedIn ↗</a>
      </div>
      <a class="feed-link" href="/feed/">/feed</a>
    </div>
  </section>
</BaseLayout>
